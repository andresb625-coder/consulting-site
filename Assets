<style>
:root{
  --accent:{{ACCENT}};
  --accent-2:{{ACCENT_2}};
  --accent-rgb:{{ACCENT_RGB}};
  --page:#f7f7f5;
  --surface:#ffffff;
  --ink:#131a22;
  --ink-2:#4a5561;
  --line:#e2e4e1;
  --display:"Fraunces",Georgia,serif;
  --body:"Instrument Sans",-apple-system,"Segoe UI",sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition:none!important;animation:none!important}
}
body{
  font-family:var(--body);
  background:var(--page);
  color:var(--ink);
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
a{color:var(--accent)}
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{
  outline:2px solid var(--accent);outline-offset:2px;
}
::selection{background:rgba(var(--accent-rgb),.16)}

/* ---- section header: accent dash + micro-caps kicker + hairline to edge ---- */
.kicker-row{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.kicker-row::before{content:"";width:28px;height:2px;background:var(--accent);flex:none}
.kicker-row::after{content:"";height:1px;background:var(--line);flex:1}
.kicker{
  font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
  color:var(--accent);white-space:nowrap;
}
@media (max-width:640px){.kicker{white-space:normal}}
.section{padding:88px 0}
.section h2{
  font-family:var(--display);font-weight:560;font-size:clamp(1.7rem,3.4vw,2.4rem);
  line-height:1.15;letter-spacing:-.01em;max-width:640px;
}
.section h2 em{font-style:italic;color:var(--accent)}

/* ---- nav ---- */
.nav{
  position:sticky;top:0;z-index:50;background:rgba(247,247,245,.92);
  backdrop-filter:blur(8px);border-bottom:1px solid var(--line);
}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:60px}
.nav-name{
  font-family:var(--display);font-weight:560;font-size:1.05rem;color:var(--ink);
  text-decoration:none;letter-spacing:-.01em;
}
.nav-links{display:flex;align-items:center;gap:26px}
.nav-links a{
  color:var(--ink-2);text-decoration:none;font-size:.86rem;font-weight:500;
}
.nav-links a:hover{color:var(--ink)}
.nav-cta{
  background:var(--accent);color:#fff!important;padding:9px 18px;border-radius:4px;
  font-weight:600!important;
}
.nav-cta:hover{background:var(--accent-2)}
@media (max-width:760px){.nav-links a:not(.nav-cta){display:none}}

/* ---- hero ---- */
.hero{
  padding:110px 0 96px;position:relative;overflow:hidden;
  background:
    radial-gradient(640px 420px at 88% -10%,rgba(var(--accent-rgb),.07),transparent 70%),
    var(--page);
  border-bottom:1px solid var(--line);
}
.hero .kicker-row{max-width:520px}
.hero h1{
  font-family:var(--display);font-weight:560;
  font-size:clamp(2.5rem,6vw,4.2rem);line-height:1.06;letter-spacing:-.018em;
  max-width:850px;margin-bottom:26px;
}
.hero h1 em{font-style:italic;color:var(--accent)}
.hero-lead{font-size:1.16rem;color:var(--ink-2);max-width:580px;margin-bottom:38px}
.hero-ctas{display:flex;align-items:center;gap:22px;flex-wrap:wrap}
.btn{
  display:inline-block;background:var(--accent);color:#fff;text-decoration:none;
  font-weight:600;font-size:.95rem;padding:14px 30px;border-radius:4px;
  border:none;cursor:pointer;font-family:var(--body);
  transition:background .15s ease,transform .15s ease;
}
.btn:hover{background:var(--accent-2);transform:translateY(-1px)}
.hero-alt{font-size:.92rem;color:var(--ink-2)}
.hero-alt a{color:var(--ink);font-weight:500}

/* ---- stats ---- */
.stats{border-bottom:1px solid var(--line);background:var(--surface)}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
.stat{padding:34px 24px;border-left:1px solid var(--line)}
.stat:first-child{border-left:none}
.stat-value{
  font-family:var(--display);font-weight:560;font-size:2.1rem;line-height:1.1;
  color:var(--ink);letter-spacing:-.01em;
}
.stat-label{
  font-size:11px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;
  color:var(--ink-2);margin-top:6px;
}
@media (max-width:760px){
  .stats-grid{grid-template-columns:1fr 1fr}
  .stat{border-left:none;border-top:1px solid var(--line)}
  .stat:nth-child(-n+2){border-top:none}
}

/* ---- services ---- */
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
.service{
  background:var(--surface);border:1px solid var(--line);border-radius:6px;
  padding:30px 26px;position:relative;transition:transform .15s ease,box-shadow .15s ease;
}
.service::before{
  content:"";position:absolute;top:-1px;left:-1px;right:-1px;height:3px;
  background:var(--accent);border-radius:6px 6px 0 0;
  transform:scaleX(0);transform-origin:left;transition:transform .2s ease;
}
.service:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(19,26,34,.07)}
.service:hover::before{transform:scaleX(1)}
.service h3{
  font-family:var(--display);font-weight:560;font-size:1.28rem;line-height:1.25;
  margin-bottom:10px;letter-spacing:-.01em;
}
.service p{font-size:.95rem;color:var(--ink-2)}
@media (max-width:900px){.services-grid{grid-template-columns:1fr 1fr}}
@media (max-width:620px){.services-grid{grid-template-columns:1fr}}

/* ---- process ---- */
.process{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.steps{margin-top:48px;position:relative;max-width:680px}
.steps::before{
  content:"";position:absolute;left:19px;top:8px;bottom:8px;width:1px;background:var(--line);
}
.step{position:relative;padding:0 0 40px 66px}
.step:last-child{padding-bottom:0}
.step-num{
  position:absolute;left:0;top:0;width:40px;height:40px;border-radius:50%;
  background:var(--accent);color:#fff;font-weight:600;font-size:.9rem;
  display:flex;align-items:center;justify-content:center;
}
.step h3{
  font-family:var(--display);font-weight:560;font-size:1.22rem;margin-bottom:6px;
  letter-spacing:-.01em;padding-top:6px;
}
.step p{font-size:.95rem;color:var(--ink-2);max-width:520px}

/* ---- about ---- */
.about-grid{display:grid;grid-template-columns:340px 1fr;gap:64px;margin-top:44px;align-items:start}
.about-photo{position:relative}
.about-photo img{
  width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:6px;display:block;
  position:relative;z-index:1;
}
.about-photo::after{
  content:"";position:absolute;inset:14px -14px -14px 14px;
  border:1px solid var(--accent);border-radius:6px;opacity:.5;
}
.about-bio p{color:var(--ink-2);margin-bottom:16px;max-width:560px}
.about-bio p:first-child{color:var(--ink);font-size:1.08rem}
@media (max-width:820px){
  .about-grid{grid-template-columns:1fr;gap:40px}
  .about-photo{max-width:340px}
}

/* ---- testimonials ---- */
.quotes-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:44px}
.quote{
  background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:32px 30px;
}
.quote-mark{
  font-family:var(--display);font-size:3rem;line-height:.6;color:var(--accent);
  display:block;margin-bottom:18px;font-weight:640;
}
.quote p{font-size:1.02rem;color:var(--ink);margin-bottom:20px}
.quote-who{
  font-size:11px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;
  color:var(--ink-2);
}
.quote-who b{color:var(--ink)}
@media (max-width:720px){.quotes-grid{grid-template-columns:1fr}}

/* ---- contact ---- */
.contact{background:var(--surface);border-top:1px solid var(--line)}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-top:44px;align-items:start}
.contact-lead{color:var(--ink-2);max-width:440px;margin-bottom:34px}
.contact-row{padding:16px 0;border-top:1px solid var(--line)}
.contact-row-label{
  font-size:11px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;
  color:var(--ink-2);margin-bottom:2px;
}
.contact-row a{color:var(--ink);text-decoration:none;font-weight:500}
.contact-row a:hover{color:var(--accent)}
.form-card{
  background:var(--page);border:1px solid var(--line);border-radius:6px;padding:34px 30px;
}
.form-card label{
  display:block;font-size:11px;font-weight:600;letter-spacing:.13em;
  text-transform:uppercase;color:var(--ink-2);margin:0 0 6px;
}
.form-card input,.form-card textarea{
  width:100%;font-family:var(--body);font-size:.98rem;color:var(--ink);
  background:var(--surface);border:1px solid var(--line);border-radius:4px;
  padding:12px 14px;margin-bottom:20px;
}
.form-card input:focus,.form-card textarea:focus{border-color:var(--accent);outline:none}
.form-card textarea{min-height:120px;resize:vertical}
.form-card .btn{width:100%}
.ghl-embed iframe{width:100%;min-height:520px;border:none;border-radius:6px;background:var(--surface)}
.mailto-card{text-align:center;padding:48px 30px}
.mailto-card p{color:var(--ink-2);margin-bottom:24px}
@media (max-width:820px){.contact-grid{grid-template-columns:1fr;gap:40px}}

/* ---- footer ---- */
.footer{background:var(--ink);color:#aeb6bf;padding:44px 0}
.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.footer-name{font-family:var(--display);font-weight:560;font-size:1.05rem;color:#fff}
.footer a{color:#dfe4e9;text-decoration:none}
.footer a:hover{color:#fff}
.footer-meta{font-size:.85rem}
</style>
</head>
<body>

<nav class="nav">
  <div class="wrap nav-inner">
    <a class="nav-name" href="#top">{{CLIENT_NAME}}</a>
    <div class="nav-links">
      <a href="#services">Services</a>
      <!-- IF:sections.process.enabled --><a href="#process">How we work</a><!-- /IF -->
      <!-- IF:sections.about.enabled --><a href="#about">About</a><!-- /IF -->
      <!-- IF:sections.testimonials.enabled --><a href="#testimonials">Results</a><!-- /IF -->
      <a class="nav-cta" href="#contact">{{SITE_CTA_TEXT}}</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap">
    <!-- IF:SITE_HERO_KICKER -->
    <div class="kicker-row"><span class="kicker">{{SITE_HERO_KICKER}}</span></div>
    <!-- /IF -->
    <h1>{{SITE_HERO_H1}}</h1>
    <p class="hero-lead">{{SITE_HERO_LEAD}}</p>
    <div class="hero-ctas">
      <a class="btn" href="#contact">{{SITE_CTA_TEXT}}</a>
      <span class="hero-alt">or email <a href="mailto:{{CONTACT_EMAIL}}">{{CONTACT_EMAIL}}</a></span>
    </div>
  </div>
</header>

<!-- IF:sections.stats.enabled -->
<section class="stats" aria-label="Results at a glance">
  <div class="wrap">
    <div class="stats-grid">
      <!-- EACH:sections.stats.items -->
      <div class="stat">
        <div class="stat-value">{{item.value}}</div>
        <div class="stat-label">{{item.label}}</div>
      </div>
      <!-- /EACH -->
    </div>
  </div>
</section>
<!-- /IF -->

<section class="section" id="services">
  <div class="wrap">
    <div class="kicker-row"><span class="kicker">{{SITE_SERVICES_KICKER}}</span></div>
    <h2>{{SITE_SERVICES_HEADING}}</h2>
    <div class="services-grid">
      <!-- EACH:services -->
      <div class="service">
        <h3>{{item.title}}</h3>
        <p>{{item.blurb}}</p>
      </div>
      <!-- /EACH -->
    </div>
  </div>
</section>

<!-- IF:sections.process.enabled -->
<section class="section process" id="process">
  <div class="wrap">
    <div class="kicker-row"><span class="kicker">{{SITE_PROCESS_KICKER}}</span></div>
    <h2>{{SITE_PROCESS_HEADING}}</h2>
    <div class="steps">
      <!-- EACH:sections.process.steps -->
      <div class="step">
        <div class="step-num">{{index1}}</div>
        <h3>{{item.title}}</h3>
        <p>{{item.blurb}}</p>
      </div>
      <!-- /EACH -->
    </div>
  </div>
</section>
<!-- /IF -->

<!-- IF:sections.about.enabled -->
<section class="section" id="about">
  <div class="wrap">
    <div class="kicker-row"><span class="kicker">{{SITE_ABOUT_KICKER}}</span></div>
    <h2>{{SITE_ABOUT_HEADING}}</h2>
    <div class="about-grid">
      <div class="about-photo">
        <img src="{{ABOUT_HEADSHOT_SRC}}" alt="{{SITE_ABOUT_HEADING}}">
      </div>
      <div class="about-bio">
        <!-- EACH:sections.about.bio_paragraphs -->
        <p>{{item.value}}</p>
        <!-- /EACH -->
      </div>
    </div>
  </div>
</section>
<!-- /IF -->

<!-- IF:sections.testimonials.enabled -->
<section class="section" id="testimonials">
  <div class="wrap">
    <div class="kicker-row"><span class="kicker">{{SITE_TESTIMONIALS_KICKER}}</span></div>
    <h2>{{SITE_TESTIMONIALS_HEADING}}</h2>
    <div class="quotes-grid">
      <!-- EACH:sections.testimonials.quotes -->
      <div class="quote">
        <span class="quote-mark">&ldquo;</span>
        <p>{{item.text}}</p>
        <div class="quote-who"><b>{{item.name}}</b> &middot; {{item.company}}</div>
      </div>
      <!-- /EACH -->
    </div>
  </div>
</section>
<!-- /IF -->

<section class="section contact" id="contact">
  <div class="wrap">
    <div class="kicker-row"><span class="kicker">{{SITE_CONTACT_KICKER}}</span></div>
    <div class="contact-grid">
      <div>
        <h2>{{SITE_CONTACT_HEADING}}</h2>
        <p class="contact-lead" style="margin-top:18px">{{SITE_CONTACT_LEAD}}</p>
        <div class="contact-row">
          <div class="contact-row-label">Email</div>
          <a href="mailto:{{CONTACT_EMAIL}}">{{CONTACT_EMAIL}}</a>
        </div>
        <!-- IF:CONTACT_PHONE -->
        <div class="contact-row">
          <div class="contact-row-label">Phone</div>
          <a href="tel:{{CONTACT_PHONE}}">{{CONTACT_PHONE}}</a>
        </div>
        <!-- /IF -->
        <!-- IF:CONTACT_LOCATION -->
        <div class="contact-row">
          <div class="contact-row-label">Location</div>
          {{CONTACT_LOCATION}}
        </div>
        <!-- /IF -->
      </div>
      <div>
        <!-- IF:FORM_GHL -->
        <div class="ghl-embed">
          <iframe src="https://api.leadconnectorhq.com/widget/form/{{GHL_FORM_ID}}" id="inline-{{GHL_FORM_ID}}" title="Contact form"></iframe>
        </div>
        <!-- /IF -->
        <!-- IF:FORM_FORMSPREE -->
        <form class="form-card" action="{{FORMSPREE_ENDPOINT}}" method="POST">
          <label for="cf-name">Name</label>
          <input id="cf-name" type="text" name="name" required>
          <label for="cf-email">Email</label>
          <input id="cf-email" type="email" name="email" required>
          <label for="cf-message">How can we help?</label>
          <textarea id="cf-message" name="message" required></textarea>
          <button class="btn" type="submit">{{SITE_CTA_TEXT}}</button>
        </form>
        <!-- /IF -->
        <!-- IF:FORM_MAILTO -->
        <div class="form-card mailto-card">
          <p>The fastest way to reach us is a short email. Tell us about your business and what you're trying to grow.</p>
          <a class="btn" href="mailto:{{CONTACT_EMAIL}}">Email {{CLIENT_NAME}}</a>
        </div>
        <!-- /IF -->
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer-inner">
    <div>
      <div class="footer-name">{{CLIENT_NAME}}</div>
      <!-- IF:SITE_FOOTER_LINE --><div class="footer-meta">{{SITE_FOOTER_LINE}}</div><!-- /IF -->
    </div>
    <div class="footer-meta">
      <a href="mailto:{{CONTACT_EMAIL}}">{{CONTACT_EMAIL}}</a>
      &nbsp;&middot;&nbsp; &copy; {{YEAR}} {{CLIENT_NAME}}
    </div>
  </div>
</footer>

</body>
</html>
