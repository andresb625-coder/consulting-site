#!/usr/bin/env python3
"""Render a single-page consulting website (site.html + site.ghl.html) from config.json.

Usage:
  python3 render.py <config.json> --out <dir> [--image-mode inline|relative] [--check-only]

Template lives in ../assets/ relative to this script. Missing optional values
render visible PENDING placeholders and are listed in the DEFERRED summary;
leftover {{TOKEN}} markers are a hard error (exit 1).

Contact form renders one of three modes (first match wins):
  contact.ghl_form_id set        -> GHL form iframe embed
  contact.formspree_endpoint set -> plain <form> POSTing to Formspree
  neither                        -> mailto button to contact.email
"""
import argparse
import base64
import json
import mimetypes
import re
import shutil
import sys
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path

ASSETS = Path(__file__).resolve().parent.parent / "assets"

# ---------------------------------------------------------------- engine

EACH_RE = re.compile(r"<!--\s*EACH:([\w.]+)\s*-->(.*?)<!--\s*/EACH\s*-->", re.S)
IF_RE = re.compile(
    r"<!--\s*IF:([\w.]+)\s*-->"
    r"((?:(?!<!--\s*(?:IF:|/IF)).)*?)"
    r"(?:<!--\s*ELSE\s*-->((?:(?!<!--\s*(?:IF:|/IF)).)*?))?"
    r"<!--\s*/IF\s*-->",
    re.S,
)
TOKEN_RE = re.compile(r"\{\{([\w.]+)\}\}")


# ---------------------------------------------------------------- GHL fragment
# Shared verbatim with vsl-pages and webinar-pages render.py — patch all together.

# A GHL "Custom HTML / Code" element must receive a FRAGMENT, never a whole
# document. Pasting a complete document produces a page with two <head> and
# two <body> tags; the browser discards the second <head> along with every
# <style> inside it, and the page renders as a blank white screen with no
# error. Confirmed on a live client funnel 2026-08-05 (curl showed 2 <head>).
#
# <link> and <style> are body-ok per the HTML spec and every browser applies
# them, so fonts and layout survive the move out of <head>.
HEAD_RE = re.compile(r"<head[^>]*>(.*?)</head>", re.S | re.I)
BODY_RE = re.compile(r"<body[^>]*>(.*?)</body>", re.S | re.I)
# GHL supplies these itself; a second copy is at best ignored, at worst breaks layout
HEAD_DROP_RE = re.compile(r"<meta\s[^>]*>|<title>.*?</title>", re.S | re.I)
WRAPPER_RE = re.compile(r"<!DOCTYPE|<html|</html>|<head>|</head>|<body|</body>", re.I)
COMMENT_RE = re.compile(r"<!--.*?-->", re.S)

GHL_BANNER = """<!-- ============================================================
     {name} - GHL PASTE BLOCK
     Generated by render.py. Do not edit by hand - re-render instead.

     Paste this into the funnel step's Custom HTML / Code element.
     This is the only paste this step needs.

     Do NOT paste the matching full .html file. That one is a complete
     HTML document, and inside GHL it renders as a blank white screen.
     ============================================================ -->
"""


def ghl_fragment(html, name):
    """Strip the document wrapper so the markup can live inside a GHL page.

    Returns (fragment, error). error is None on success.
    """
    head, body = HEAD_RE.search(html), BODY_RE.search(html)
    if not head or not body:
        return None, "no <head>/<body> found"
    kept = HEAD_DROP_RE.sub("", head.group(1)).strip()
    frag = GHL_BANNER.format(name=name) + "\n" + kept + "\n\n" + body.group(1).strip() + "\n"
    # the banner above talks ABOUT <head>/<body>, so check real markup only
    leaked = sorted(set(WRAPPER_RE.findall(COMMENT_RE.sub("", frag))))
    if leaked:
        return None, f"wrapper tags leaked into fragment: {', '.join(leaked)}"
    return frag, None


def dig(data, path):
    cur = data
    for part in path.split("."):
        if isinstance(cur, dict):
            cur = cur.get(part)
        else:
            return None
    return cur


def truthy(val):
    if isinstance(val, str):
        return bool(val.strip())
    return bool(val)


def render_template(text, ctx, cfg):
    def lookup(path, scope=None):
        if scope is not None and path.startswith("item."):
            # optional per-item fields render as empty, not as leftover tokens
            val = dig(scope, path[5:])
            return "" if val is None else val
        if scope is not None and path in ("index", "index1"):
            return scope["__" + path]
        if path in ctx:
            return ctx[path]
        return dig(cfg, path)

    def do_each(m):
        items = lookup(m.group(1))
        if not items:
            return ""
        out = []
        for i, item in enumerate(items):
            scope = dict(item) if isinstance(item, dict) else {"value": item}
            scope["__index"], scope["__index1"] = i, i + 1
            block = m.group(2)
            block = TOKEN_RE.sub(
                lambda t: str(lookup(t.group(1), scope))
                if lookup(t.group(1), scope) is not None
                else t.group(0),
                block,
            )
            out.append(block)
        return "".join(out)

    text = EACH_RE.sub(do_each, text)

    # innermost-first IF resolution; loop until stable
    while True:
        new = IF_RE.sub(
            lambda m: (m.group(2) if truthy(lookup(m.group(1))) else (m.group(3) or "")),
            text,
        )
        if new == text:
            break
        text = new

    text = TOKEN_RE.sub(
        lambda t: str(lookup(t.group(1))) if lookup(t.group(1)) is not None else t.group(0),
        text,
    )
    return text


# ---------------------------------------------------------------- images

PLACEHOLDER_SVG = (
    "data:image/svg+xml;utf8,"
    + urllib.parse.quote(
        '<svg xmlns="http://www.w3.org/2000/svg" width="600" height="700">'
        '<rect width="100%" height="100%" fill="#f1f3f6" stroke="#94a3b8" '
        'stroke-width="4" stroke-dasharray="14 10"/>'
        '<text x="50%" y="50%" fill="#64748b" font-family="sans-serif" '
        'font-size="34" text-anchor="middle">IMAGE PENDING</text></svg>'
    )
)


class Images:
    def __init__(self, mode, out_dir, config_dir, deferred):
        self.mode = mode
        self.out_assets = out_dir / "assets"
        self.config_dir = config_dir
        self.deferred = deferred
        self.count = 0

    def resolve(self, src, label):
        if not src:
            self.deferred.append(f"{label}: no image yet (placeholder shown)")
            return PLACEHOLDER_SVG
        if src.startswith("data:"):
            return src
        is_url = src.startswith("http://") or src.startswith("https://")
        if self.mode == "inline":
            data, mime = self._load(src, is_url, label)
            if data is None:
                return PLACEHOLDER_SVG
            return f"data:{mime};base64,{base64.b64encode(data).decode()}"
        # relative mode
        self.out_assets.mkdir(parents=True, exist_ok=True)
        if is_url:
            return src  # already hosted; leave absolute
        p = Path(src).expanduser()
        if not p.is_absolute():
            p = self.config_dir / p
        if not p.exists():
            self.deferred.append(f"{label}: file not found: {src} (placeholder shown)")
            return PLACEHOLDER_SVG
        self.count += 1
        dest = self.out_assets / f"{self.count:02d}-{p.name}"
        shutil.copy(p, dest)
        return f"assets/{dest.name}"

    def _load(self, src, is_url, label):
        try:
            if is_url:
                with urllib.request.urlopen(src, timeout=30) as r:
                    data = r.read()
                    mime = r.headers.get_content_type()
            else:
                p = Path(src).expanduser()
                if not p.is_absolute():
                    p = self.config_dir / p
                data = p.read_bytes()
                mime = mimetypes.guess_type(p.name)[0] or "image/jpeg"
            return data, mime
        except Exception as e:
            self.deferred.append(f"{label}: could not load {src} ({e}); placeholder shown")
            return None, None


# ---------------------------------------------------------------- main

def hex_to_rgb(hexstr):
    h = (hexstr or "").lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    try:
        return f"{int(h[0:2], 16)},{int(h[2:4], 16)},{int(h[4:6], 16)}"
    except (ValueError, IndexError):
        return "31,58,95"  # navy fallback


def build_context(cfg, images, deferred):
    client = cfg["client"]["name"]
    slug = cfg["client"].get("slug") or client.lower().replace(" ", "-")
    brand = cfg.get("brand", {})
    contact = cfg.get("contact", {})
    sitec = dig(cfg, "copy.site") or {}

    accent = brand.get("accent", "#1F3A5F")
    email = contact.get("email", "")

    # contact form mode: first match wins
    ghl_form = contact.get("ghl_form_id", "")
    formspree = contact.get("formspree_endpoint", "")
    form_ghl = "1" if ghl_form else ""
    form_formspree = "1" if (formspree and not ghl_form) else ""
    form_mailto = "" if (ghl_form or formspree) else "1"

    ctx = {
        "ACCENT": accent,
        "ACCENT_2": brand.get("accent_2", accent),
        "ACCENT_RGB": hex_to_rgb(accent),
        "CLIENT_NAME": client,
        "SLUG": slug,
        "TAGLINE": cfg["client"].get("tagline", ""),
        "YEAR": str(datetime.now().year),
        "CONTACT_EMAIL": email,
        "CONTACT_PHONE": contact.get("phone", ""),
        "CONTACT_LOCATION": contact.get("location", ""),
        "GHL_FORM_ID": ghl_form,
        "FORMSPREE_ENDPOINT": formspree,
        "FORM_GHL": form_ghl,
        "FORM_FORMSPREE": form_formspree,
        "FORM_MAILTO": form_mailto,
        "POSTHOG_KEY": dig(cfg, "tracking.posthog_key") or "",
        "POSTHOG_HOST": dig(cfg, "tracking.posthog_host") or "https://us.i.posthog.com",
        "META_PIXEL_ID": dig(cfg, "tracking.meta_pixel_id") or "",
        "OG_IMAGE": cfg.get("og_image", ""),
    }

    # generic default copy so a minimal config still renders (70% ship);
    # config copy.site.* values override
    defaults = {
        "SITE_META_TITLE": f"{client} · {cfg['client'].get('tagline') or 'Consulting'}",
        "SITE_META_DESCRIPTION": f"{client} — consulting for businesses that want to grow. Get in touch today.",
        "SITE_HERO_KICKER": cfg["client"].get("tagline", ""),
        "SITE_HERO_LEAD": "We help businesses find what's holding them back and fix it — strategy, marketing, and operations that actually move the number that matters.",
        "SITE_CTA_TEXT": "Get in Touch",
        "SITE_SERVICES_KICKER": "What we do",
        "SITE_SERVICES_HEADING": "Services",
        "SITE_PROCESS_KICKER": "How we work",
        "SITE_PROCESS_HEADING": "A process that respects your time",
        "SITE_ABOUT_KICKER": "Who you'll work with",
        "SITE_ABOUT_HEADING": f"Meet {client}",
        "SITE_TESTIMONIALS_KICKER": "Client results",
        "SITE_TESTIMONIALS_HEADING": "What clients say",
        "SITE_CONTACT_KICKER": "Next step",
        "SITE_CONTACT_HEADING": "Let's talk about your business",
        "SITE_CONTACT_LEAD": "Tell us where you are and where you want to be. We'll reply within one business day.",
        "SITE_FOOTER_LINE": "",
    }
    ctx = {**defaults, **{k: v for k, v in ctx.items() if v or k not in defaults}}

    # expose every string key of copy.site as SITE_* — no per-field wiring needed
    for k, v in sitec.items():
        if isinstance(v, str) and v:
            ctx[f"SITE_{k.upper()}"] = v

    if truthy(dig(cfg, "sections.about.enabled")):
        ctx["ABOUT_HEADSHOT_SRC"] = images.resolve(
            dig(cfg, "sections.about.headshot") or "", "about headshot"
        )
        if not dig(cfg, "sections.about.bio_paragraphs"):
            deferred.append("about bio: empty — About section renders bare")
    else:
        ctx["ABOUT_HEADSHOT_SRC"] = ""

    # required-ish fields that degrade to visible placeholders
    if not ctx.get("SITE_HERO_H1"):
        ctx["SITE_HERO_H1"] = "[HEADLINE PENDING] What you do, for whom, in one line"
        deferred.append("hero headline: using placeholder text")
    if not cfg.get("services"):
        deferred.append("services: none configured — section renders a placeholder card")
        cfg["services"] = [
            {"title": "[SERVICE PENDING]", "blurb": "Describe this service in one or two sentences."}
        ]
    if not email:
        deferred.append("contact email: missing — mailto button and footer render a placeholder")
        ctx["CONTACT_EMAIL"] = "hello@example.com"
    if form_mailto and not (ghl_form or formspree):
        deferred.append("contact form: no GHL form or Formspree endpoint — mailto button only")
    return ctx


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("config")
    ap.add_argument("--out", default=".")
    ap.add_argument("--image-mode", choices=["inline", "relative"], default=None)
    ap.add_argument("--check-only", action="store_true")
    args = ap.parse_args()

    cfg_path = Path(args.config).resolve()
    cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
    out_dir = Path(args.out).resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    image_mode = args.image_mode or dig(cfg, "images.mode") or "inline"

    deferred = []
    images = Images(image_mode, out_dir, cfg_path.parent, deferred)

    template = (ASSETS / "site.template.html").read_text(encoding="utf-8")

    problems = []
    written = []

    def emit(name, text):
        leftovers = sorted(set(TOKEN_RE.findall(text)))
        if leftovers:
            problems.append(f"{name}: unresolved tokens: {', '.join(leftovers)}")
        if not args.check_only:
            (out_dir / name).write_text(text, encoding="utf-8")
            written.append(name)
            # paste-ready twin for GHL; the full file above is for hosting
            frag, err = ghl_fragment(text, name)
            if err:
                problems.append(f"{name}: GHL fragment not written ({err})")
            else:
                ghl_name = name.replace(".html", ".ghl.html")
                (out_dir / ghl_name).write_text(frag, encoding="utf-8")
                written.append(ghl_name)

    ctx = build_context(cfg, images, deferred)
    emit("site.html", render_template(template, ctx, cfg))

    for name in written:
        size = (out_dir / name).stat().st_size
        note = "  (!) large — fine for GHL paste, use relative mode for hosting" if size > 900_000 else ""
        print(f"wrote {out_dir / name}  {size/1024:.0f}KB{note}")

    if deferred:
        print("\nDEFERRED (ship now, fill later):")
        for d in sorted(set(deferred)):
            print(f"  - {d}")

    if problems:
        print("\nERRORS:", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        sys.exit(1)
    print("\ncheck pass: no unresolved tokens")


if __name__ == "__main__":
    main()
